# AWS Profile to use (e.g. opencode)
AWS_PROFILE=opencode
AWS_DEFAULT_REGION=us-east-1

# Optional Bedrock model configuration
# BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# S3 bucket for synthetic data observation layer
SMS_S3_BUCKET=your-bucket-name-here

# Temporary external LLM adapter (if bedrock is unavailable)
SMS_LLM_PROVIDER=gemini
SMS_EXTERNAL_API_KEY=
SMS_EXTERNAL_MODEL=gemini-3.6-flash

# ---- Semantic Memory Layer ------------------------------------------------
# DynamoDB table for persistent document metadata (PAY_PER_REQUEST billing)
# Must be created via AWS console or IaC before use.
SMS_DYNAMO_TABLE=sms-semantic-memory

# S3 Vectors - vector bucket name (must be created via AWS console or IaC)
SMS_VECTOR_BUCKET=your-vector-bucket-name-here
# Index within the S3 Vector bucket (default: sms-embeddings)
SMS_VECTOR_INDEX=sms-embeddings

# Embedding provider: gemini (temporary) | bedrock (production target)
SMS_EMBEDDING_PROVIDER=gemini
# Temporary Gemini embedding model (gemini-embedding-2 is current as of 2026)
SMS_GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Final Bedrock embedding model (once account restriction is lifted)
SMS_BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
